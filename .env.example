# Required for AI-powered grammar/spelling analysis and the executive summary.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — defaults to a cost-efficient model. Upgrade for higher-quality grammar analysis.
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional — overrides the browser User-Agent the auditor sends. Defaults to a stock desktop
# Chrome UA. Set this if a specific host's bot-detection (e.g. Pressable) still blocks the default.
AUDIT_USER_AGENT=

# Optional — enables audit history (crawl comparison, sitemap-crawl grouping). Without this,
# audits still run normally but nothing is saved. MySQL connection string, e.g.:
# mysql://qa_portal_app:password@localhost:3306/qa_portal
DATABASE_URL=
